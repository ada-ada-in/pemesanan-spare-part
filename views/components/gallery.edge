<div id="fh5co-gallery" style="background: url('images/so-white.png'); background-repeat: repeat; position: relative;">
    <img class="flower-3-top" src="images/flowers/top-2.svg" style="position: absolute; top: 0; left: 50%; transform: translateX(-50%);">
    <img class="flower-4-bottom" src="images/flowers/bottom-2.svg" style="position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);">

    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="text-center fh5co-heading">
                <h2 class="mt-5 position-relative">Galeri Foto</h2>
                <h3 style="color: #bf9b73">Khitbah Day - 07 November 2021</h3>
            </div>
        </div>
        <div class="row justify-content-center">

                <div id="carouselExample" class="carousel slide">
                    <div class="carousel-inner">
                      <div class="carousel-item active">
                        <img src="images/couples/man.jpg" class="d-block w-100" alt="images/couples/man">
                      </div>
                      <div class="carousel-item">
                        <img src="images/couples/woman.jpg" class="d-block w-100" alt="images/couples/man">
                      </div>
                      <div class="carousel-item">
                        <img src="images/couples/man.jpg" class="d-block w-100" alt="images/couples/man">
                      </div>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                      <span class="carousel-control-next-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Next</span>
                    </button>

                  </div>                  
        </div>
    </div>
</div>
